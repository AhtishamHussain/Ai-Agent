# ============================================
# SPEED MODE: Groq ~70B (closest free "80B-class")
# Auto-rotate keys when one hits rate limit / expires
# ============================================

LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# Put MULTIPLE free Groq keys (comma-separated). App switches automatically.
# Get keys: https://console.groq.com/keys  (create several free accounts/keys)
GROQ_API_KEYS=

# Or numbered:
# GROQ_API_KEY=gsk_key1
# GROQ_API_KEY_2=gsk_key2
# GROQ_API_KEY_3=gsk_key3

# If all Groq keys fail → fall back to local DeepSeek R1
OLLAMA_FALLBACK=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=deepseek-r1:8b
